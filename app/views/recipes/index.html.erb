<section class="page-hero page-hero--compact">
  <div>
    <p class="eyebrow">RECIPE LIBRARY</p>
    <h1>今日は、なにを作ろう？</h1>
    <p>読み上げながら作れる、みんなのレシピノートです。</p>
  </div>
  <%= link_to new_recipe_path, class: "btn btn-main" do %>
    <span aria-hidden="true">＋</span> 新しいレシピを書く
  <% end %>
</section>

<section class="page-section page-section--first">
  <% if @recipes.any? %>
    <div class="recipe-grid">
      <%= render partial: "recipe_card", collection: @recipes, as: :recipe, locals: { owner_actions: true } %>
    </div>
  <% else %>
    <div class="empty-state">
      <span class="empty-state__icon" aria-hidden="true">🍲</span>
      <h2>レシピはまだありません</h2>
      <p>最初のレシピを登録して、料理中に読み上げてみましょう。</p>
      <%= link_to "最初のレシピを書く", new_recipe_path, class: "btn btn-main" %>
    </div>
  <% end %>
</section>
