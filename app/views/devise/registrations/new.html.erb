<h2 class="form-heading">📝 新規登録</h2>

<%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= f.error_notification %>

  <div class="form-section">
    <%= f.input :nickname,required: true,label: "ユーザー名" %>
    <%= f.input :email, required: true, label: "メールアドレス" %>
    <%= f.input :password, required: true, label: "パスワード" %>
    <%= f.input :password_confirmation, required: true, label: "パスワード（確認）" %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "登録する", class: "btn btn-main" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
