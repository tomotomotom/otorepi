<section class="auth-page">
  <div class="auth-card">
    <p class="eyebrow">WELCOME BACK</p>
    <h1>ログイン</h1>
    <p class="auth-card__intro">保存したレシピと、いつもの料理時間に戻りましょう。</p>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-inputs">
        <%= f.input :email, label: "メールアドレス",
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email" } %>
        <%= f.input :password, label: "パスワード",
                    required: false,
                    input_html: { autocomplete: "current-password" } %>
        <%= f.input :remember_me, as: :boolean, label: "ログイン状態を保持する" if devise_mapping.rememberable? %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "ログインする", class: "btn btn-main" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</section>
