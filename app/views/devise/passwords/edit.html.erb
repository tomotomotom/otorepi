<section class="auth-page">
  <div class="auth-card">
    <p class="eyebrow">NEW PASSWORD</p>
    <h1>新しいパスワード</h1>
    <p class="auth-card__intro">新しいパスワードを2回入力してください。</p>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.error_notification %>
      <%= f.input :reset_password_token, as: :hidden %>
      <%= f.full_error :reset_password_token %>
      <div class="form-inputs">
        <%= f.input :password, label: "新しいパスワード", required: true, autofocus: true,
                    hint: (t('devise.shared.minimum_password_length', count: @minimum_password_length) if @minimum_password_length),
                    input_html: { autocomplete: "new-password" } %>
        <%= f.input :password_confirmation, label: "新しいパスワード（確認）", required: true,
                    input_html: { autocomplete: "new-password" } %>
      </div>
      <div class="form-actions">
        <%= f.button :submit, "パスワードを変更する", class: "btn btn-main" %>
      </div>
    <% end %>
    <%= render "devise/shared/links" %>
  </div>
</section>
