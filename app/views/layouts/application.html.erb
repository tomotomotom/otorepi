<!DOCTYPE html>
<html>
  <head>
    <title>オトレピ | 聴きながらつくるレシピ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="材料や料理手順を音声で確認できる、料理中にやさしいレシピアプリです。">
    <meta name="theme-color" content="#f26b3a">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to root_path, class: "brand", aria: { label: "オトレピ トップ" } do %>
          <span class="brand__mark" aria-hidden="true">♪</span>
          <span>オトレピ</span>
        <% end %>

        <nav class="nav-links" aria-label="メインメニュー">
          <%= link_to 'トップ', root_path, class: 'nav-link' %>
          <%= link_to 'レシピを探す', recipes_path, class: 'nav-link nav-link--recipes' %>
          <% if user_signed_in? %>
            <%= link_to 'レシピを書く', new_recipe_path, class: 'nav-link nav-link--accent' %>
            <%= link_to current_user.nickname.presence || "マイページ", edit_user_registration_path, class: 'nav-link nav-link--user' %>
            <%= link_to 'ログアウト', destroy_user_session_path, data: { turbo_method: :delete }, class: 'nav-link nav-link--muted' %>
          <% else %>
            <%= link_to 'ログイン', new_user_session_path, class: 'nav-link' %>
            <%= link_to '無料ではじめる', new_user_registration_path, class: 'nav-link nav-link--accent' %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <% flash.each do |type, message| %>
        <div class="flash flash--<%= type %>" role="status"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div>
          <strong class="site-footer__brand">オトレピ</strong>
          <p>手がふさがっていても、レシピは耳で確認。</p>
        </div>
        <small>© <%= Date.today.year %> Otorepi</small>
      </div>
    </footer>
  </body>
</html>
