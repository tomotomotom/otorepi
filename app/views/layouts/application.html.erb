<!DOCTYPE html>
<html>
  <head>
    <title>Otorepi</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <h1 class="logo">🍳 オトレピ</h1>
        <% if user_signed_in? %>
        <span class="nav-user">
          ようこそ、
          <%= link_to current_user.nickname.presence || "ユーザー", edit_user_registration_path, class: 'nav-link' %> さん
          </span>
          <% end %>
        <nav class="nav-links">
          <%= link_to '🏠 トップ', root_path, class: 'nav-link' %>
          <%= link_to '📋 レシピ一覧', recipes_path, class: 'nav-link' %>
         <% if user_signed_in? %>
         <%= link_to '➕ レシピ登録', new_recipe_path, class: 'nav-link' %>
         <%= link_to 'ログアウト', destroy_user_session_path, method: :delete, data: { turbo_method: :delete }, class: 'nav-link' %>
         <% else %>
         <%= link_to 'ログイン', new_user_session_path, class: 'nav-link' %>
         <%= link_to '新規登録', new_user_registration_path, class: 'nav-link' %>
         <% end %>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <small>© <%= Date.today.year %> オトレピ - Otorepi</small>
      </div>
    </footer>
  </body>
</html>
